#!/usr/bin/env bash

# SPDX-FileCopyrightText: 2026 Xquik contributors
#
# SPDX-License-Identifier: Apache-2.0

# Audits Go dependencies with govulncheck and blocks on:
#
# - any finding in a package that the provider binary links;
# - any other finding that has a fixed version;
# - any other finding that audit-exceptions.json does not list.
#
# An exception names the advisory, the package path, a reason ("build-time
# only" or "peer dependency provided by the host") and a recheck date at most
# 30 days out. It stops counting on its recheck date.

set -euo pipefail

cd "$(dirname "$0")/.."

# Keep the SDK staging module outside the public module proxy.
export GOPRIVATE="${GOPRIVATE:+$GOPRIVATE,}github.com/stainless-sdks/x-twitter-scraper-go"

readonly exceptions_file="audit-exceptions.json"
readonly temp_root="${TMPDIR:-/tmp}"

workspace="$(mktemp -d "${temp_root%/}/vulncheck.XXXXXX")"
cleanup() {
  case "$workspace" in
    "${temp_root%/}"/vulncheck.*)
      rm -rf -- "$workspace"
      ;;
  esac
}
trap cleanup EXIT

today="$(date +%F)"
if ! latest_recheck="$(date -v+30d +%F 2>/dev/null)"; then
  latest_recheck="$(date -d '+30 days' +%F)"
fi

if ! jq -e '
  (.exceptions | type) == "array"
  and all(.exceptions[];
    (.advisory | type) == "string"
    and (.package | type) == "string"
    and (.reason == "build-time only" or .reason == "peer dependency provided by the host")
    and (.recheck | type) == "string"
    and (.recheck | test("^[0-9]{4}-[0-9]{2}-[0-9]{2}$")))
' "$exceptions_file" >/dev/null; then
  echo "$exceptions_file is invalid. Give each entry advisory, package, reason & recheck." >&2
  exit 1
fi

echo "==> Scanning Go dependencies with govulncheck"
go run golang.org/x/vuln/cmd/govulncheck@v1.9.0 -format json ./... >"$workspace/findings.json"
go list -deps . >"$workspace/shipped-packages.txt"

verdicts="$(
  jq -r -n \
    --slurpfile stream "$workspace/findings.json" \
    --rawfile shipped_text "$workspace/shipped-packages.txt" \
    --slurpfile config "$exceptions_file" \
    --arg today "$today" \
    --arg latest "$latest_recheck" '
    ($shipped_text | split("\n") | map(select(length > 0))) as $shipped
    | $config[0].exceptions as $exceptions
    | [
        $stream[]
        | select(.finding)
        | .finding
        | {
            advisory: .osv,
            module: .trace[0].module,
            package: (.trace[0].package // null),
            fixed: (.fixed_version // "")
          }
      ]
    | group_by(.advisory)
    | map(
        map(select(.package != null)) as $imported
        | if ($imported | length) > 0 then
            $imported | group_by(.package) | map(.[0] + {fixed: (map(.fixed) | max), linked: true})
          else
            [.[0] + {package: .[0].module, fixed: (map(.fixed) | max), linked: false}]
          end
      )
    | flatten as $findings
    | (
        $findings[]
        | . as $finding
        | "\($finding.advisory) in \($finding.package)\(if $finding.module == $finding.package then "" else " (\($finding.module))" end)" as $name
        | ($exceptions | map(select(.advisory == $finding.advisory and .package == $finding.package)) | first) as $entry
        | if $finding.linked and any($shipped[]; . == $finding.package) then
            "BLOCK\t\($name) ships in the provider binary. \($finding.fixed | if . == "" then "No fix exists yet" else "Upgrade to \(.)" end)."
          elif $finding.fixed != "" then
            "BLOCK\t\($name) has a fix. Upgrade to \($finding.fixed)."
          elif $entry == null then
            "BLOCK\t\($name) has no fix and no entry in audit-exceptions.json."
          elif $entry.recheck <= $today then
            "BLOCK\t\($name) reached its recheck date \($entry.recheck). Review it again."
          elif $entry.recheck > $latest then
            "BLOCK\t\($name) has a recheck date more than 30 days out. Use \($latest) or sooner."
          else
            "ALLOW\t\($name) is excepted until \($entry.recheck): \($entry.reason)."
          end
      ),
      (
        $exceptions[]
        | . as $entry
        | select(all($findings[]; .advisory != $entry.advisory or .package != $entry.package))
        | "NOTE\t\($entry.advisory) in \($entry.package) no longer shows up. Remove it from audit-exceptions.json."
      )
  '
)"

blocked=0
while IFS=$'\t' read -r verdict message; do
  if [[ -z "$verdict" ]]; then
    continue
  fi
  echo "$verdict: $message"
  if [[ "$verdict" == "BLOCK" ]]; then
    blocked=$((blocked + 1))
  fi
done <<<"$verdicts"

if [[ "$blocked" -gt 0 ]]; then
  echo "$blocked findings block. Run go run golang.org/x/vuln/cmd/govulncheck@v1.9.0 ./... for call traces." >&2
  exit 1
fi

echo "No blocking vulnerability findings."
