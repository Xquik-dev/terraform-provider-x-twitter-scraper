#!/usr/bin/env bash

# SPDX-FileCopyrightText: 2026 Xquik contributors
#
# SPDX-License-Identifier: Apache-2.0

set -euo pipefail

cd "$(dirname "$0")/.."

# Keep the SDK staging module outside the public module proxy.
export GOPRIVATE="${GOPRIVATE:+$GOPRIVATE,}github.com/stainless-sdks/x-twitter-scraper-go"

echo "==> Verifying module integrity"
go mod verify

echo "==> Running tests with race detection"
go test -race ./... "$@"

if [[ "$#" -eq 0 ]]; then
  echo "==> Enforcing statement coverage"
  ./scripts/coverage
  ./scripts/branch-coverage
fi

echo "==> Checking Windows compilation"
CGO_ENABLED=0 GOOS=windows GOARCH=amd64 go test -exec=true ./...
