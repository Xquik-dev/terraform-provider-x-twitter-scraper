#!/usr/bin/env bash

# SPDX-FileCopyrightText: 2026 Xquik contributors
#
# SPDX-License-Identifier: Apache-2.0

set -euo pipefail

cd -- "$(dirname -- "$0")/.."

readonly pack_name="codeql/go-queries"
readonly pack_version="1.6.12"
readonly suite_path="codeql-suites/go-security-extended.qls"
readonly comment_pack="codeql/no-code-comments"
readonly extraction_diagnostic="go/diagnostics/extraction-errors"
readonly download_limit="${CODEQL_DOWNLOAD_SECONDS:-300}"

[[ "$download_limit" =~ ^[1-9][0-9]*$ ]] || {
  echo "CODEQL_DOWNLOAD_SECONDS must be a whole number of seconds, such as 300." >&2
  exit 2
}

temp_root="${TMPDIR:-/tmp}"
workspace="$(mktemp -d "${temp_root%/}/xquik-terraform-codeql.XXXXXX")"
trap 'rm -rf -- "${workspace:?}"' EXIT
workspace="$(cd -- "$workspace" && pwd -P)"
readonly source_root="$workspace/source"
readonly packs="$workspace/packs"
readonly caches="$workspace/caches"
readonly database="$workspace/database"
readonly results="$workspace/results.sarif"

stop_tree() {
  local child
  for child in $(pgrep -P "$1" 2>/dev/null || true); do
    stop_tree "$child"
  done
  kill "$1" 2>/dev/null || true
}

run_with_limit() {
  local limit="$1" waited=0 status=0 pid
  shift
  "$@" &
  pid=$!
  while kill -0 "$pid" 2>/dev/null; do
    if ((waited >= limit)); then
      stop_tree "$pid"
      wait "$pid" 2>/dev/null || true
      return 124
    fi
    sleep 1
    waited=$((waited + 1))
  done
  wait "$pid" || status=$?
  return "$status"
}

echo "==> Using CodeQL $(codeql version --format=terse)"

echo "==> Downloading $pack_name $pack_version"
status=0
run_with_limit "$download_limit" codeql pack download "$pack_name@$pack_version" \
  --dir="$packs" --common-caches="$caches" || status=$?
if ((status == 124)); then
  echo "The CodeQL pack download stalled for $download_limit seconds. Check the network, then rerun." >&2
  exit 1
elif ((status != 0)); then
  echo "CodeQL could not download $pack_name $pack_version. Check the network and GitHub access, then rerun." >&2
  exit 1
fi
readonly pack_dir="$packs/$pack_name/$pack_version"
if ! grep -qx "version: $pack_version" "$pack_dir/qlpack.yml" 2>/dev/null ||
  [[ ! -f "$pack_dir/$suite_path" ]]; then
  echo "The downloaded $pack_name pack is incomplete. Rerun to download it again." >&2
  exit 1
fi

echo "==> Installing the libraries of the comment query"
status=0
run_with_limit "$download_limit" codeql pack install "$comment_pack" --common-caches="$caches" || status=$?
if ((status == 124)); then
  echo "The CodeQL library download stalled for $download_limit seconds. Check the network, then rerun." >&2
  exit 1
elif ((status != 0)); then
  echo "CodeQL could not install the libraries of $comment_pack. Check the network and GitHub access, then rerun." >&2
  exit 1
fi

echo "==> Copying the source files for CodeQL"
mkdir -p -- "$source_root"
git ls-files --cached --others --exclude-standard -z |
  tar --null -T - -cf - |
  tar -xf - -C "$source_root"

echo "==> Building the CodeQL database"
codeql database create "$database" \
  --language=go \
  --build-mode=autobuild \
  --extractor-option=go.extract_tests=true \
  --source-root="$source_root" \
  --common-caches="$caches" \
  --threads=0

expected="$(
  cd -- "$source_root"
  go list -json ./... | jq -r '.Dir as $dir | ((.GoFiles // []) + (.TestGoFiles // []) + (.XTestGoFiles // []))[] | "\($dir)/\(.)"' |
    sed "s|^.*${source_root#/}/||" | LC_ALL=C sort -u
)"
scanned="$(
  unzip -Z1 "$database/src.zip" |
    grep -E '\.go$' |
    sed "s|^.*${source_root#/}/||" | LC_ALL=C sort -u
)"
missing="$(LC_ALL=C comm -23 <(printf '%s\n' "$expected") <(printf '%s\n' "$scanned"))"
expected_count="$(grep -c . <<<"$expected" || true)"
if ((expected_count == 0)) || [[ -n "$missing" ]]; then
  printf '%s\n' "$missing" >&2
  echo "CodeQL missed the Go files above. Fix the build so it compiles every package." >&2
  exit 1
fi

echo "==> Running the CodeQL security-extended and comment queries"
codeql database analyze "$database" "$pack_name@$pack_version:$suite_path" "$comment_pack" \
  --additional-packs="$packs" \
  --common-caches="$caches" \
  --format=sarif-latest \
  --output="$results" \
  --threads=0

if ! jq -e --arg id "$extraction_diagnostic" \
  'any(.runs[].tool["driver"].notifications[]?; .id == $id)' "$results" >/dev/null; then
  echo "The CodeQL scan lacks $extraction_diagnostic, so it cannot show that it read every file. Make the suite in scripts/codeql run that diagnostic query." >&2
  exit 1
fi
unread="$(jq -r --arg id "$extraction_diagnostic" \
  '.runs[].invocations[]?.toolExecutionNotifications[]? | select(.descriptor.id == $id) | .message.text' "$results")"
if [[ -n "$unread" ]]; then
  printf '%s\n' "$unread" >&2
  echo "CodeQL could not read the Go code named above, so the scan is incomplete. Fix that code so Go compiles it, then rerun." >&2
  exit 1
fi

result_count="$(jq '[.runs[].results[]] | length' "$results")"
if ((result_count > 0)); then
  jq -r '.runs[].results[]
    | .locations[0].physicalLocation as $where
    | "\(.ruleId) at \($where.artifactLocation.uri):\($where.region.startLine)"' "$results" >&2
  echo "CodeQL found $result_count results. Fix each one above, then rerun." >&2
  exit 1
fi

echo "==> Checking the comment query on a fixture package"
readonly fixture_root="$workspace/comment-fixture"
readonly fixture_database="$workspace/comment-fixture-database"
readonly fixture_results="$workspace/comment-fixture.sarif"
mkdir -p -- "$fixture_root"
printf 'module example.com/commentfixture\n\ngo 1.27\n' >"$fixture_root/go.mod"
cat >"$fixture_root/first.go" <<'GO'
// Package commentfixture keeps this package comment.
package commentfixture

// Value has a declaration comment.
var Value = 1
GO
cat >"$fixture_root/second.go" <<'GO'
// Package commentfixture has a second package comment.
package commentfixture

// A line comment.
var second = Value // A trailing comment.
GO
cat >"$fixture_root/first_test.go" <<'GO'
// Package commentfixture has a test package comment.
package commentfixture
GO
mkdir -p -- "$fixture_root/cmd/tool"
cat >"$fixture_root/cmd/tool/main.go" <<'GO'
// Command tool has a command comment.
package main

func main() {}
GO
codeql database create "$fixture_database" \
  --language=go \
  --build-mode=autobuild \
  --extractor-option=go.extract_tests=true \
  --source-root="$fixture_root" \
  --common-caches="$caches" \
  --threads=0
codeql database analyze "$fixture_database" "$comment_pack" \
  --common-caches="$caches" \
  --format=sarif-latest \
  --output="$fixture_results" \
  --threads=0
flagged="$(jq -r '.runs[].results[]
  | .locations[0].physicalLocation
  | "\(.artifactLocation.uri):\(.region.startLine)"' "$fixture_results" | LC_ALL=C sort)"
readonly expected_flags="cmd/tool/main.go:1
first.go:4
first_test.go:1
second.go:1
second.go:4
second.go:5"
if [[ "$flagged" != "$expected_flags" ]]; then
  echo "The comment query flagged these fixture lines." >&2
  printf '%s\n' "$flagged" >&2
  echo "It must flag these lines, every comment except the first package comment of each non-main package." >&2
  printf '%s\n' "$expected_flags" >&2
  exit 1
fi

echo "CodeQL read all $expected_count Go files and found no results."
