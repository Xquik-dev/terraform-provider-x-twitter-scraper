#!/usr/bin/env bash

# SPDX-FileCopyrightText: 2026 Xquik contributors
#
# SPDX-License-Identifier: Apache-2.0

set -euo pipefail
set +o xtrace

cd -- "$(dirname -- "$0")/.."

source scripts/temp-paths

readonly repository="Xquik-dev/terraform-provider-x-twitter-scraper"
readonly project="terraform-provider-x-twitter-scraper"
readonly registry_versions_url="https://registry.terraform.io/v1/providers/Xquik-dev/x-twitter-scraper/versions"
readonly gpg_key_id="4900C25E85324F28"
readonly version_pattern='^[0-9]+\.[0-9]+\.[0-9]+(-[0-9A-Za-z][0-9A-Za-z.-]*)?$'

dry_run=false
for argument in "$@"; do
  case "$argument" in
    --dry-run) dry_run=true ;;
    *)
      echo "Unknown option $argument. Run bin/release-local or bin/release-local --dry-run." >&2
      exit 2
      ;;
  esac
done

step() {
  echo "==> $1"
}

refuse() {
  echo "$1" >&2
  exit 1
}

if [[ "$dry_run" == false && -z "${RELEASE_SIGNING_KEYCHAIN_SERVICE:-}" ]]; then
  refuse "RELEASE_SIGNING_KEYCHAIN_SERVICE is not set. Set it to the Keychain item that holds the GPG passphrase, then rerun."
fi

remove_local_tag=false

cleanup() {
  remove_temp_paths
  if [[ "$remove_local_tag" == true ]]; then
    git tag --delete "$tag" >/dev/null
  fi
}
trap cleanup EXIT
exit_on_signals
workspace=""
make_temp workspace release -d

step "Checking required tools"
required_tools=(cmp curl gh git go jq shasum unzip)
if [[ "$dry_run" == false ]]; then
  required_tools+=(gpg security)
fi
for tool in "${required_tools[@]}"; do
  command -v "$tool" >/dev/null 2>&1 || refuse "$tool is not installed. Install it, then rerun."
done
if ! command -v goreleaser >/dev/null 2>&1; then
  command -v brew >/dev/null 2>&1 || refuse "GoReleaser is not installed. Install it with Homebrew, then rerun."
  step "Installing GoReleaser with Homebrew"
  brew install goreleaser
fi

step "Checking that the working tree is clean"
[[ -z "$(git status --porcelain)" ]] ||
  refuse "The working tree has changes. Commit or remove them, then rerun."

step "Checking that main is checked out"
[[ "$(git symbolic-ref --quiet --short HEAD || true)" == main ]] ||
  refuse "The current branch is not main. Switch to main, then rerun."

step "Checking that main matches origin/main"
git fetch --quiet origin main ||
  refuse "git could not fetch origin. Check the network, then rerun."
commit="$(git rev-parse HEAD)"
[[ "$commit" == "$(git rev-parse origin/main)" ]] ||
  refuse "main differs from origin/main. Pull or push main, then rerun."

step "Reading the version from .release-please-manifest.json"
version="$(jq -er '."."' .release-please-manifest.json)" ||
  refuse ".release-please-manifest.json has no version. Fix it, then rerun."
[[ "$version" =~ $version_pattern ]] ||
  refuse "Version $version is not a semantic version. Fix .release-please-manifest.json, then rerun."
grep -Fq "PackageVersion = \"$version\"" internal/version.go ||
  refuse "internal/version.go does not say $version. Merge the release pull request first."
readonly version
readonly tag="v$version"
readonly checksums="dist/${project}_${version}_SHA256SUMS"
readonly signature="$checksums.sig"

step "Checking that tag $tag is not on origin yet"
remote_tag="$(git ls-remote --tags origin "refs/tags/$tag")" ||
  refuse "git could not read the tags of origin. Check the network, then rerun."
[[ -z "$remote_tag" ]] || refuse "Tag $tag already exists on origin. Bump the version, then rerun."
local_tag=false
if git rev-parse --quiet --verify "refs/tags/$tag" >/dev/null; then
  [[ "$(git cat-file -t "refs/tags/$tag")" == tag && "$(git rev-parse "refs/tags/$tag^{commit}")" == "$commit" ]] ||
    refuse "Local tag $tag is not an annotated tag on HEAD. Delete it with git tag -d $tag, then rerun."
  local_tag=true
fi

step "Reading the release notes for $version from CHANGELOG.md"
notes_file="$workspace/notes.md"
awk -v heading="## $version" '
  /^## / {
    if (found) exit
    found = ($0 == heading || index($0, heading " ") == 1)
    next
  }
  found { print }
' CHANGELOG.md >"$notes_file"
grep -q '[^[:space:]]' "$notes_file" ||
  refuse "CHANGELOG.md has no section for $version. Merge the release pull request first."

step "Checking GitHub CLI access"
gh auth status --hostname github.com >/dev/null 2>&1 ||
  refuse "The GitHub CLI is not signed in. Run gh auth login, then rerun."

step "Checking GitHub releases for $tag"
published=false
if lookup="$(gh api "repos/$repository/releases/tags/$tag" 2>&1)"; then
  [[ "$(jq -r '.draft' <<<"$lookup")" == true ]] || published=true
elif [[ "$lookup" != *"HTTP 404"* ]]; then
  refuse "GitHub did not answer for release $tag. Check the network and gh auth status, then rerun."
fi
drafts="$(
  gh api --paginate --slurp "repos/$repository/releases?per_page=100" |
    jq -c --arg tag "$tag" '[.[][] | select(.tag_name == $tag and .draft)]'
)" || refuse "GitHub did not list the releases. Check the network and gh auth status, then rerun."
draft_count="$(jq 'length' <<<"$drafts")"
((draft_count <= 1)) || refuse "Several draft releases use $tag. Delete the extra drafts on GitHub, then rerun."
if [[ "$published" == true ]]; then
  if [[ "$dry_run" == false ]]; then
    refuse "GitHub release $tag is already published. Bump the version, then rerun."
  fi
  echo "GitHub release $tag is already published. A real release would stop here."
fi

step "Checking whether the Terraform Registry has $version"
registry_versions="$(curl -fsS --max-time 30 --proto '=https' "$registry_versions_url")" ||
  refuse "The Terraform Registry did not answer. Check the network, then rerun."
if jq -e --arg version "$version" 'any(.versions[]; .version == $version)' <<<"$registry_versions" >/dev/null; then
  if [[ "$dry_run" == false ]]; then
    refuse "The Terraform Registry already has $version. Bump the version, then rerun."
  fi
  echo "The Terraform Registry already has $version. A real release would stop here."
fi

step "Checking GPG key $gpg_key_id"
fingerprint=""
if command -v gpg >/dev/null 2>&1; then
  fingerprint="$(
    gpg --batch --with-colons --list-secret-keys "$gpg_key_id" 2>/dev/null |
      awk -F: '$1 == "fpr" { print $10; exit }' || true
  )"
fi
if [[ "$dry_run" == true ]]; then
  if [[ -n "$fingerprint" ]]; then
    echo "GPG key $gpg_key_id is in the keyring. A dry run never signs."
  else
    echo "GPG key $gpg_key_id is not in the keyring. A real release would stop here."
  fi
else
  [[ -n "$fingerprint" ]] ||
    refuse "GPG secret key $gpg_key_id is not in the keyring. Import it, then rerun."
  security find-generic-password -s "$RELEASE_SIGNING_KEYCHAIN_SERVICE" >/dev/null 2>&1 ||
    refuse "The Keychain has no item named by RELEASE_SIGNING_KEYCHAIN_SERVICE. Add the GPG passphrase there, then rerun."
fi

step "Running bin/check-local"
if [[ "$dry_run" == true ]]; then
  bin/check-local --no-status
else
  bin/check-local
fi

step "Auditing dependencies with govulncheck"
./scripts/audit

if [[ "$local_tag" == true ]]; then
  step "Reusing the local annotated tag $tag"
else
  step "Creating the local annotated tag $tag for the build. The run removes it unless it pushes it."
  git tag --annotate "$tag" --message "Release $tag"
  remove_local_tag=true
fi

step "Building the release assets for $tag with GoReleaser"
GORELEASER_CURRENT_TAG="$tag" goreleaser release --clean --skip=publish,validate,sign ||
  refuse "The GoReleaser build failed. Fix the errors above, then rerun."
./bin/check-release-debug-info
install -m 0644 terraform-registry-manifest.json "dist/${project}_${version}_manifest.json"
[[ -z "$(git status --porcelain)" ]] ||
  refuse "The build changed tracked files. Fix the build so it leaves the tree alone, then rerun."

step "Listing the release"
./scripts/release-listing "$version" "$notes_file"

if [[ "$dry_run" == true ]]; then
  echo "Dry run finished. Nothing was published, tagged or released."
  exit 0
fi

step "Signing ${checksums#dist/} with GPG key $gpg_key_id"
security find-generic-password -s "$RELEASE_SIGNING_KEYCHAIN_SERVICE" -w |
  gpg --batch --yes --pinentry-mode loopback --passphrase-fd 0 \
    --local-user "$fingerprint" --output "$signature" --detach-sign "$checksums" ||
  refuse "gpg could not sign ${checksums#dist/}. Check the key and its passphrase, then rerun."
gpg --batch --status-fd 1 --verify "$signature" "$checksums" 2>/dev/null |
  awk -v fingerprint="$fingerprint" '$2 == "VALIDSIG" && $NF == fingerprint { found = 1 } END { exit !found }' ||
  refuse "The signature does not verify with GPG key $gpg_key_id. Check the key, then rerun."
if cmp -s -n 5 "$signature" <(printf '%s' '-----'); then
  refuse "gpg wrote an ASCII armored signature. Remove armor from the gpg configuration, then rerun."
fi

asset_paths=("$checksums" "$signature")
while IFS= read -r name; do
  asset_paths+=("dist/$name")
done < <(awk '{ print $2 }' "$checksums")
expected_assets="$(printf '%s\n' "${asset_paths[@]#dist/}" | jq -R . | jq -cs 'sort')"

if ((draft_count == 0)); then
  step "Creating draft release $tag with notes from CHANGELOG.md"
  gh release create "$tag" --repo "$repository" --draft --title "$tag" \
    --target "$commit" --notes-file "$notes_file" ||
    refuse "GitHub did not create draft release $tag. Check gh auth status, then rerun."
fi

step "Uploading ${#asset_paths[@]} release assets to draft $tag"
gh release upload "$tag" "${asset_paths[@]}" --repo "$repository" --clobber ||
  refuse "GitHub did not take the release assets. Rerun to upload them to the draft again."

step "Checking that draft $tag holds every asset"
uploaded_assets="$(gh release view "$tag" --repo "$repository" --json assets --jq '[.assets[].name] | sort')" ||
  refuse "GitHub did not show draft release $tag. Check gh auth status, then rerun."
[[ "$(jq -c '.' <<<"$uploaded_assets")" == "$expected_assets" ]] ||
  refuse "Draft release $tag does not hold exactly the built assets. Fix the draft on GitHub, then rerun."
mkdir -p "$workspace/draft"
gh release download "$tag" --repo "$repository" --dir "$workspace/draft" \
  --pattern "${checksums#dist/}" --pattern "${signature#dist/}" ||
  refuse "GitHub did not return the SHA256SUMS files of draft $tag. Retry later."
for local_file in "$checksums" "$signature"; do
  cmp -s "$local_file" "$workspace/draft/${local_file#dist/}" ||
    refuse "The SHA256SUMS files on draft $tag differ from this build. Rerun to upload them again."
done

step "Pushing tag $tag to origin"
git push --quiet origin "refs/tags/$tag"
remove_local_tag=false

if [[ "$version" == *-* ]]; then
  release_flags=(--prerelease --latest=false)
else
  release_flags=(--latest)
fi

step "Publishing GitHub release $tag with notes from CHANGELOG.md"
gh release edit "$tag" --repo "$repository" --draft=false --verify-tag \
  --title "$tag" --notes-file "$notes_file" "${release_flags[@]}" ||
  refuse "Tag $tag is pushed. Publish its draft release on GitHub with notes from CHANGELOG.md."

echo "Released $tag at https://github.com/$repository/releases/tag/$tag. The Terraform Registry reads it from GitHub."
