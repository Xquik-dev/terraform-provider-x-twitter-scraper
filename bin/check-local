#!/usr/bin/env bash

# SPDX-FileCopyrightText: 2026 Xquik contributors
#
# SPDX-License-Identifier: Apache-2.0

set -euo pipefail

cd -- "$(dirname -- "$0")/.."

# shellcheck source=scripts/temp-paths
source scripts/temp-paths

readonly repository="Xquik-dev/terraform-provider-x-twitter-scraper"
readonly status_context="xquik-local-checks"
readonly status_limit=139
readonly reuse_version="6.2.0"

post_requested=true
for argument in "$@"; do
  case "$argument" in
    --no-status) post_requested=false ;;
    *)
      echo "Unknown option $argument. Run bin/check-local or bin/check-local --no-status." >&2
      exit 2
      ;;
  esac
done

readonly fuzz_time="${FUZZ_TIME:-15s}"
check_name="Startup"
check_label=""
check_hint="Fix the error above, then rerun."
passed_checks=()
status_sha=""

post_status() {
  if [[ -z "$status_sha" ]]; then
    return 0
  fi
  local description="$2"
  gh api --method POST "repos/$repository/statuses/$status_sha" \
    -f state="$1" \
    -f context="$status_context" \
    -f description="${description:0:$status_limit}" >/dev/null ||
    echo "Could not post the $1 commit status. Check gh auth status and push access." >&2
}

finish() {
  local status=$?
  remove_temp_paths
  if ((status != 0)); then
    echo "Check failed at $check_name. $check_hint" >&2
    post_status failure "Failed at $check_name."
  fi
}
trap finish EXIT
exit_on_signals
workspace=""
make_temp workspace check -d

start_check() {
  check_name="$1"
  check_label="$2"
  check_hint="$3"
  echo "==> $check_name"
}

pass_check() {
  if [[ -n "$check_label" ]]; then
    passed_checks+=("$check_label")
  fi
}

snapshot_checksums() {
  local checksums
  goreleaser release --snapshot --clean --skip=sign >&2 || return 1
  checksums="$(find dist -maxdepth 1 -type f -name '*_SHA256SUMS' -print -quit)"
  if [[ -z "$checksums" ]]; then
    echo "GoReleaser wrote no SHA256SUMS file to dist." >&2
    return 1
  fi
  printf '%s\n' "$checksums"
}

tree_state="$(git status --porcelain)"

echo "==> Commit status"
if [[ "$post_requested" == false ]]; then
  echo "Commit status not posted because --no-status was passed."
elif ! command -v gh >/dev/null 2>&1; then
  echo "Commit status not posted because gh is not installed."
elif [[ -n "$tree_state" ]]; then
  echo "Commit status not posted because the working tree has changes."
else
  head_sha="$(git rev-parse HEAD)"
  if gh api "repos/$repository/commits/$head_sha" >/dev/null 2>&1; then
    status_sha="$head_sha"
    post_status pending "Local checks are running."
    echo "Posting $status_context for $head_sha."
  else
    echo "Commit status not posted because GitHub has no commit $head_sha. Push it, or run gh auth login."
  fi
fi

start_check "Required tools" "" "Install the missing tool, then rerun."
for tool in cmp codeql git go goreleaser jq objdump pgrep shellcheck tar unzip uvx; do
  if ! command -v "$tool" >/dev/null 2>&1; then
    case "$tool" in
      codeql) check_hint="Install the CodeQL CLI with brew install --cask codeql, then rerun." ;;
      go) check_hint="Install Go from https://go.dev/dl/, then rerun." ;;
      goreleaser) check_hint="Install GoReleaser with brew install goreleaser, then rerun." ;;
      objdump) check_hint="Install the Xcode command line tools with xcode-select --install, then rerun." ;;
      shellcheck) check_hint="Install ShellCheck with brew install shellcheck, then rerun." ;;
      uvx) check_hint="Install uv with brew install uv, then rerun." ;;
      *) check_hint="Install $tool, then rerun." ;;
    esac
    exit 1
  fi
done

start_check "API coverage" "API coverage" "Follow the lines above, then rerun."
go run ./scripts/api_coverage.go
pass_check

start_check "Module download and integrity" "modules" "Run go clean -modcache, then rerun."
SKIP_BREW=1 ./scripts/bootstrap
pass_check

start_check "REUSE licensing" "REUSE" "Add the missing license notice or REUSE.toml entry, then rerun."
uvx --from "reuse==$reuse_version" reuse lint
pass_check

start_check "Lint" "lint" "Run ./scripts/format and go mod tidy, fix the go vet findings above, then rerun."
./scripts/lint
pass_check

start_check "Shell scripts" "shellcheck" "Fix the shellcheck findings above, then rerun."
shell_scripts=()
for script in bin/* scripts/* scripts/tests/*; do
  if [[ -f "$script" && "$(head -n 1 "$script")" == "#!/usr/bin/env bash" ]]; then
    shell_scripts+=("$script")
  fi
done
shellcheck --external-sources "${shell_scripts[@]}"
pass_check

start_check "Script tests" "script tests" "Fix the failing script tests above, then rerun."
./scripts/test-scripts
pass_check

start_check "Go tests and coverage" "Go tests" "Fix the failing test or add coverage, then rerun."
./scripts/test
pass_check

start_check "Dependency audit" "audit" "Upgrade each blocked module above, or raise the go line in go.mod for standard library findings."
./scripts/audit | tee "$workspace/audit.log"
exceptions="$(sed -nE 's/^Dependency audit passed with ([0-9]+) reviewed exceptions?\.$/\1/p' "$workspace/audit.log")"
case "$exceptions" in
  "") ;;
  1) check_label="audit (1 exception)" ;;
  *) check_label="audit ($exceptions exceptions)" ;;
esac
pass_check

start_check "Release configuration" "" "Fix .goreleaser.yml, or make terraform-registry-manifest.json name protocol 6.0 only."
goreleaser check
jq -e '.version == 1 and .metadata.protocol_versions == ["6.0"]' terraform-registry-manifest.json >/dev/null

start_check "Reproducible snapshot build" "" "Remove the build input that changes between builds, such as a timestamp."
first_checksums="$(snapshot_checksums)"
cp -- "$first_checksums" "$workspace/first-checksums.txt"
second_checksums="$(snapshot_checksums)"
cmp -- "$workspace/first-checksums.txt" "$second_checksums"

start_check "Release debug information" "reproducible build" "Keep DWARF data. Remove -s and -w from the .goreleaser.yml ldflags."
./bin/check-release-debug-info
pass_check

start_check "Fuzzing" "fuzzing" "Fix the crash. Go saved its input under internal/apiform/testdata/fuzz."
go test ./internal/apiform -run '^$' -fuzz '^FuzzMarshalRoundTrip$' -fuzztime="$fuzz_time"
pass_check

start_check "CodeQL security-extended queries" "CodeQL" "Fix the CodeQL error or results above, then rerun."
./scripts/codeql
pass_check

if [[ -z "$tree_state" ]]; then
  start_check "Unchanged working tree" "" "A check changed or added the files above. Fix that check so it leaves the tree alone, then rerun."
  tree_changes="$(git status --porcelain)"
  if [[ -n "$tree_changes" ]]; then
    echo "$tree_changes"
    exit 1
  fi
fi

check_name="Commit status"
summary=""
last_index=$((${#passed_checks[@]} - 1))
for index in "${!passed_checks[@]}"; do
  if ((index == 0)); then
    summary="${passed_checks[$index]}"
  elif ((index == last_index)); then
    summary="$summary & ${passed_checks[$index]}"
  else
    summary="$summary, ${passed_checks[$index]}"
  fi
done
summary="Passed $summary."
if ((${#summary} > status_limit)); then
  summary="Passed all ${#passed_checks[@]} checks. Run bin/check-local to list them."
fi
post_status success "$summary"
echo "$summary"
