#!/usr/bin/env bash
set -euo pipefail
cd -- "$(dirname -- "$0")/.."
version="$(jq -er '.goreleaser_version' release-policy.json)"
[[ "$version" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]]
jq -e '.version == 1 and .metadata.protocol_versions == ["6.0"]' terraform-registry-manifest.json >/dev/null
exec ./bin/run-goreleaser check
